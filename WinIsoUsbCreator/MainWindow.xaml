<Window x:Class="WinIsoUsbCreator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AirysDark WinISO USB Creator" Width="720" Height="540" Background="#151A20" Foreground="#E6EDF3" WindowStartupLocation="CenterScreen">
<Window.Resources><Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="#D8782A"/><Setter Property="Foreground" Value="White"/></Style><Style TargetType="TextBox"><Setter Property="Background" Value="#242C35"/><Setter Property="Foreground" Value="White"/></Style></Window.Resources>
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="AIRYSDARK WINISO USB CREATOR" FontSize="24" FontWeight="Bold"/><TextBlock Text="Creates a FAT32 boot partition and a second partition containing the Windows ISO." Opacity=".75" Margin="0,6,0,0"/></StackPanel>
<StackPanel Grid.Row="2"><TextBlock Text="Windows ISO"/><DockPanel Margin="0,5,0,12"><Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseIso_Click"/><TextBox x:Name="IsoPathBox" IsReadOnly="True" Padding="8"/></DockPanel><TextBlock Text="USB Device"/><ComboBox x:Name="DriveCombo" DisplayMemberPath="DisplayName" Margin="0,5,0,4"/><Button Content="Refresh USB Drives" HorizontalAlignment="Left" Click="Refresh_Click"/></StackPanel>
<StackPanel Grid.Row="4"><TextBlock Text="Boot partition: 4 GB FAT32     ISO partition: remaining space (exFAT)" FontWeight="SemiBold"/><CheckBox x:Name="ConfirmErase" Content="I understand that the selected USB drive will be completely erased." Margin="0,12,0,8"/><Button x:Name="CreateButton" Content="CREATE BOOTABLE USB" Height="42" FontSize="15" Click="Create_Click"/></StackPanel>
<StackPanel Grid.Row="5" Margin="0,20,0,0"><ProgressBar x:Name="Progress" Height="22" Minimum="0" Maximum="100"/><TextBlock x:Name="StatusText" Text="Ready" Margin="0,8,0,0" TextWrapping="Wrap"/><TextBlock Margin="0,12,0,0" Opacity=".65" TextWrapping="Wrap" Text="Place prepared WinPE media in the WinPE folder beside the executable before building the USB."/></StackPanel>
</Grid></Window>
